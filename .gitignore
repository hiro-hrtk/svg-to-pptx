# REF/ は消失前のプロジェクトから復旧できた断片(履歴参照用)。
# 正本は docs/ に再構築済みのため、リポジトリには含めない。
REF/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# uv / venv
.venv/

# 変換パイプラインの出力(build_pptx.py / qa_capture.py で再生成可能なため追跡しない)
output/

# input/ 直下は既定で除外し、テスト用SVGを置く input/test/ だけ追跡する。
# (本番向けの入力を input/ 直下に置く運用のため、それらはリポジトリに含めない)
input/*
!input/test/

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
